{
    "version": "0.2-matched8197",

    "experiment": "general_pretraining_v0.2_matched_v0.1_budget",

    "reference_experiment": {
        "model": "MathGPT-General-v0.1",
        "purpose": "Hold training budget and schedule constant while changing only the training corpus.",
        "reference_steps": 8197,
        "reference_token_exposures": 8393728,
        "reference_warmup_steps": 400
    },

    "data": {
        "train_binary": "data/tokenized/general_v0_2_train.bin",
        "validation_binary": "data/tokenized/general_v0_2_validation.bin",
        "tokenizer": "tokenizer_50m_v0.2",
        "corpus_training_tokens": 51776327,
        "corpus_validation_tokens": 5778078
    },

    "training": {
        "batch_size": 4,
        "context_length": 256,
        "tokens_per_step": 1024,
        "seed": 42,
        "max_steps": 8197,
        "target_token_exposures": 8393728
    },

    "optimizer": {
        "name": "adamw",
        "learning_rate": 0.0003,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "weight_decay": 0.01
    },

    "scheduler": {
        "name": "warmup_cosine",
        "warmup_steps": 400,
        "min_learning_rate": 0.00003
    },

    "gradient_clipping": {
        "enabled": true,
        "max_norm": 1.0
    },

    "logging": {
        "log_every_steps": 10
    },

    "validation": {
        "eval_every_steps": 200,
        "eval_batches": 20
    },

    "checkpointing": {
        "save_every_steps": 1000,
        "directory": "checkpoints/general_pretraining_v0.2_matched8197"
    }
}