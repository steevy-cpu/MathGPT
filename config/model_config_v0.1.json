{
    "version": "0.1",
    "architecture": "decoder_only_gpt",

    "vocab_size": 16000,
    "context_length": 256,

    "d_model": 256,
    "num_layers": 5,
    "num_heads": 4,
    "head_dim": 64,

    "d_ff": 1024,

    "activation": "gelu",

    "normalization": "pre_layernorm",

    "position_embedding": "learned",

    "tie_embeddings": true,

    "use_bias": true,

    "dropout": 0.0,

    "dtype": "float32",

    "special_token_ids": {
        "pad": 0,
        "bos": 1,
        "eos": 2
    }
}